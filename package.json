{
  "name": "atem-fleet-admin",
  "productName": "ATEM Fleet Admin",
  "version": "0.4.2",
  "description": "Provision a fleet of Blackmagic ATEM switchers at once: build each device's config through model-aware forms, then push it over the network or generate loadable XML + media folders for ATEM Software Control.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Allan Sargeant",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "preview:web": "vite --config vite.web.config.ts --port 5199",
    "web:build": "vite build --config vite.web.config.ts",
    "static:build": "vite build --config vite.static.config.ts",
    "preview:static": "vite --config vite.static.config.ts --port 5200",
    "deploy:static": "npm run static:build && npx wrangler deploy",
    "server:dev": "tsx watch src/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node out-server/server/index.js",
    "web": "npm run web:build && npm run server:build && npm run server:start",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "atem-connection": "^3.10.2",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@39.8.10": true,
    "@julusian/freetype2@1.3.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
